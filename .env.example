# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE - DIGITAL RECIPE BOOK
# ==============================================================================
# Salin file ini menjadi .env.local untuk pengembangan lokal (local development).
# JANGAN PERNAH meng-commit file .env atau .env.local yang berisi nilai secret asli!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Vite Frontend)
# Variabel dengan awalan VITE_ akan di-bundle ke dalam kode client browser.
# HANYA gunakan Public / Anon Key di sini. JANGAN taruh Service Role Key!
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (Vercel Serverless Function: api/*)
# Variabel di bawah HANYA dibaca oleh endpoint serverless di lingkungan server.
# TIDAK memakai awalan VITE_ agar TIDAK bocor ke bundle client browser.
# Masukkan salah satu atau kedua kunci di bawah ini di dashboard Vercel / env lokal.
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

